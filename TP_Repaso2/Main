public class Main {
    public static void main(String[] args) {
        Jugador j1 = new Jugador("Pepito");
        j1.mostrarDatos();
        j1.ganarPuntos(10);
        j1.ganarPuntos(-5);
        j1.subirNivel();
        Jugador j2 = new Jugador("Carlos");
        j2.mostrarDatos();
        j2.ganarPuntos(20);
        j2.ganarPuntos(-5);
        j2.subirNivel();
        j1.mostrarDatos();
        j2.mostrarDatos();

    }
}